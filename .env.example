# Copy to .env and fill in. Never commit .env.
# groq (needs GROQ_API_KEY) or fake (no key: extractive answers, for tests/eval)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
JWT_SECRET=dev-only-secret-change-me-32bytes-min!
JWT_ISSUER=moveinsync-dev
JWT_TTL_MINUTES=60
REQUEST_DEADLINE_S=2.8
LLM_TIMEOUT_S=2.5
# Generation (D41/D58). Reasoning models such as openai/gpt-oss-120b need LLM_MAX_TOKENS ~1000.
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0
RETRIEVAL_POOL=8
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.38
# vector (default) | hybrid = vector + BM25 fused with RRF (D56/D57; see EVAL_REPORT)
RETRIEVAL_MODE=vector
# D61: after a "not covered" answer, search once more with the model's search phrase and
# answer the ORIGINAL question (max 2 LLM calls). Passed its rule; on by default.
REWRITE_ON_MISS=on
# D60 (RERANK, cross-encoder reranking) failed its rule and is not on main; the code is on
# branch exp/rerank-rewrite, where RERANK=off|on exists.
DATA_DIR=var
POLICIES_DIR=data/policies
