# Copy to .env and fill in. Never commit .env.
# groq (needs GROQ_API_KEY) or fake (no key: extractive answers, for tests/eval)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
JWT_SECRET=dev-only-secret-change-me-32bytes-min!
JWT_ISSUER=moveinsync-dev
JWT_TTL_MINUTES=60
REQUEST_DEADLINE_S=2.8
LLM_TIMEOUT_S=2.5
RETRIEVAL_POOL=8
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.38
# vector (default) | hybrid = vector + BM25 fused with RRF (D56/D57; see EVAL_REPORT)
RETRIEVAL_MODE=vector
DATA_DIR=var
POLICIES_DIR=data/policies
